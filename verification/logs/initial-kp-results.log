ModifiedCartan.specht_character_projection.{u_1} {W : Type u_1} [NormedAddCommGroup W] [InnerProductSpace ℂ W]
  [FiniteDimensional ℂ W] (μ : YoungDiagram)
  (π : Representation ℂ (Equiv.Perm (Fin (ModifiedCartan.partitionSize μ))) W)
  (hπ : ModifiedCartan.IsUnitaryRepresentation π) :
  (↑(ModifiedCartan.standardSkewTableauCount μ ⊥) / ↑(ModifiedCartan.partitionSize μ).factorial) •
      ModifiedCartan.permutationCharacterOperator (ModifiedCartan.spechtRepresentation μ) π =
