ModifiedCartan.Paper.lem_plucker_translation {n m : ℕ} {ω : YoungDiagram} {V : Submodule ℂ (Polynomial ℂ)}
  (hV : V ∈ ModifiedCartan.polynomialSchubertCell n m ω) (μ : YoungDiagram) (a t : ℂ) :
  ModifiedCartan.normalizedSchubertCoordinate hV μ (a + t) =
    ∑ ν,
      ↑(ModifiedCartan.standardSkewTableauCount (↑ν) μ) /
            ↑(ModifiedCartan.partitionSize ↑ν - ModifiedCartan.partitionSize μ).factorial *
          t ^ (ModifiedCartan.partitionSize ↑ν - ModifiedCartan.partitionSize μ) *
        ModifiedCartan.normalizedSchubertCoordinate hV (↑ν) a
