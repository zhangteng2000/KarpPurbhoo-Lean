ModifiedCartan.Paper.lem_character_projection.{u_1, u_2, u_3} {ι : Type u_1} {V : Type u_2} {W : Type u_3} [Fintype ι]
  [DecidableEq ι] [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V] [NormedAddCommGroup W] [InnerProductSpace ℂ W]
  [FiniteDimensional ℂ W] (ρ : Representation ℂ (Equiv.Perm ι) V) (π : Representation ℂ (Equiv.Perm ι) W)
  [ρ.IsIrreducible] (hπ : ModifiedCartan.IsUnitaryRepresentation π) :
  (ρ.character 1 / ↑(Fintype.card ι).factorial) • ModifiedCartan.permutationCharacterOperator ρ π =
    ↑(ModifiedCartan.irreducibleCopiesSubmodule ρ π).starProjection
