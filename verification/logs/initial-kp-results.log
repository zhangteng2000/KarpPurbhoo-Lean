ModifiedCartan.Paper.lem_KP_correspondence {M n D : ℕ} (hM : 0 < M) (τ : YoungDiagram)
  (hτ : Fintype.card (Fin M) = ModifiedCartan.partitionSize τ) (hf : ModifiedCartan.PartitionFits n τ)
  (hD : n + 1 + τ.rowLen 0 ≤ D) (z : Fin M → ℂ) :
  (∀ (μ ν : YoungDiagram) (a b : ℂ),
      ModifiedCartan.kpBeta μ z a * ModifiedCartan.kpBeta ν z b =
        ModifiedCartan.kpBeta ν z b * ModifiedCartan.kpBeta μ z a) ∧
    (∀ (μ : YoungDiagram) (a : ℂ), ModifiedCartan.kpBeta μ z a ∈ ModifiedCartan.kpGeneratedAlgebra z) ∧
      ModifiedCartan.kpGeneratedAlgebra z = ModifiedCartan.betheAlgebra z ∧
        (∀ (μ : YoungDiagram) (a t : ℂ),
            ModifiedCartan.kpBeta μ z (a + t) =
              ∑ ν,
                (↑(ModifiedCartan.standardSkewTableauCount (↑ν) μ) /
                      ↑(ModifiedCartan.partitionSize ↑ν - ModifiedCartan.partitionSize μ).factorial *
                    t ^ (ModifiedCartan.partitionSize ↑ν - ModifiedCartan.partitionSize μ)) •
                  ModifiedCartan.kpBeta (↑ν) z a) ∧
          (∀ (E : Submodule ℂ ↥(ModifiedCartan.YoungSpechtModule τ)),
              ModifiedCartan.IsCommonEigenspace (ModifiedCartan.spechtRepresentationOn τ hτ).asAlgebraHom
                  (ModifiedCartan.kpGeneratedAlgebra z) E →
                ∃ V,
                  ∃ (hV : V ∈ ModifiedCartan.polynomialSchubertCell n D τ),
                    (∀ (μ : YoungDiagram),
                        ∀ v ∈ E,
                          ((ModifiedCartan.spechtRepresentationOn τ hτ).asAlgebraHom (ModifiedCartan.kpBeta μ z 0)) v =
                            ModifiedCartan.normalizedSchubertCoordinate hV μ 0 • v) ∧
                      ModifiedCartan.schubertMonicWronskian hV = ∏ i, (Polynomial.X + Polynomial.C (z i))) ∧
            ∀ (V : Submodule ℂ (Polynomial ℂ)) (hV : V ∈ ModifiedCartan.polynomialSchubertCell n D τ),
              ModifiedCartan.schubertMonicWronskian hV = ∏ i, (Polynomial.X + Polynomial.C (z i)) →
                ∃ E,
                  ModifiedCartan.IsCommonEigenspace (ModifiedCartan.spechtRepresentationOn τ hτ).asAlgebraHom
                      (ModifiedCartan.kpGeneratedAlgebra z) E ∧
                    ∀ (μ : YoungDiagram),
                      ∀ v ∈ E,
                        ((ModifiedCartan.spechtRepresentationOn τ hτ).asAlgebraHom (ModifiedCartan.kpBeta μ z 0)) v =
                          ModifiedCartan.normalizedSchubertCoordinate hV μ 0 • v
